      "model_name": "fixture",
      "model_version": null,
      "service_p95_ns": 100000000,
      "transport_p95_ns": 0,
      "margin_ns": 5000000,
      "timeout_s": 30.0,
      "max_inflight": 1,
      "reserve_microusd": 0,
      "externally_billed": false,
      "input_per_million_microusd": null,
      "cached_per_million_microusd": null,
      "output_per_million_microusd": null,
      "stream": false,
      "max_output_tokens": 256,
      "max_response_bytes": 2000000,
      "extra_body_json": "{}"
    }
  ]
}
