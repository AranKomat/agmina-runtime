{
  "tenant": "local",
  "campaign": "local-worker-contract-probe",
  "max_attempts": 12,
  "max_microusd": 0,
  "max_queue": 128,
  "max_jobs": 10000,
  "scheduler": "slack",
  "placement": "fastest",
  "cache_entries": 64,
  "cache_bytes": 8000000,
  "cache_ttl_ns": 60000000000,
  "pools": [
    {
      "id": "server-gpu",
      "slots": 1
    }
  ],
  "models": [
